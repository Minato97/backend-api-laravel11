meta {
  name: Logout
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/auth/logout
  body: none
  auth: inherit
}

script:post-response {
  if (res.status === 200) {
    bru.setEnvVar("token", "");
  }
}

tests {
  test("cierra la sesión actual", function () {
    expect(res.status).to.equal(200);
  });
}
